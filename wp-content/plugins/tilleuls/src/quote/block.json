{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tilleuls-ortego-blocks/quote",
	"version": "0.1.0",
	"title": "Citation",
	"category": "cabinet-ortego",
	"icon": "editor-quote",
	"description": "Met en valeur une phrase importante, par exemple une conviction de l'avocate. Écrivez la citation, puis le nom de son auteur.",
	"keywords": [
		"quote",
		"citation",
		"témoignage",
		"avocat"
	],
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"textdomain": "tilleuls",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"attributes": {
		"citation": {
			"type": "string",
			"default": ""
		},
		"author": {
			"type": "string",
			"default": "Maître Ilazki Ortego Sampedro"
		}
	}
}
