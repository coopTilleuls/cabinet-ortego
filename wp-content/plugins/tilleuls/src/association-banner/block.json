{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tilleuls-ortego-blocks/association-banner",
	"version": "0.1.0",
	"title": "Bandeau des engagements",
	"category": "cabinet-ortego",
	"icon": "awards",
	"description": "Un bandeau de couleur qui liste les syndicats et associations dont le cabinet est membre. Ajoutez, modifiez ou supprimez chaque engagement directement dans le bandeau.",
	"keywords": [
		"avocat",
		"syndicat",
		"expert",
		"partenaire",
		"réseau"
	],
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"innerBlocks": true
	},
	"textdomain": "tilleuls",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"attributes": {
		"color": {
			"type": "string",
			"default": "black"
		},
		"items": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"default": {
					"icon": "fa-solid fa-gavel",
					"text": ""
				}
			}
		}
	}
}
