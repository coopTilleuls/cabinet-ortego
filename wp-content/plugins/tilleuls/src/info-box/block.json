{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tilleuls-ortego-blocks/info-box",
	"version": "0.1.0",
	"title": "Encadré d'informations",
	"category": "cabinet-ortego",
	"description": "Une liste d'informations pratiques, chacune avec une petite icône et un titre (par exemple : aide juridictionnelle, moyens de paiement, adresse).",
	"keywords": [
		"info",
		"aide juridictionnelle",
		"tarif",
		"important",
		"ortego"
	],
	"supports": {
		"html": false
	},
	"textdomain": "tilleuls",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"attributes": {
		"infoItems": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"default": {
					"icon": "fa-solid fa-gavel",
					"text": ""
				}
			}
		}
	}
}
