{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tilleuls-ortego-blocks/cards",
	"version": "0.1.0",
	"title": "Cartes de présentation",
	"category": "cabinet-ortego",
	"icon": "layout",
	"description": "Plusieurs cartes côte à côte, chacune avec une icône, un titre et un court texte. Pratique pour présenter les valeurs du cabinet ou ses domaines d'intervention.",
	"keywords": [
		"philosophie",
		"carte",
		"valeurs",
		"atouts",
		"compétences",
		"ortego"
	],
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"innerBlocks": true
	},
	"textdomain": "tilleuls",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"attributes": {
		"items": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"default": {
					"icon": "fa-solid fa-gavel",
					"text": "",
					"description": ""
				}
			}
		},
		"style": {
			"type": "string",
			"default": ""
		}
	}
}
